# ── MagicLight ──────────────────────────────────────────────
# Clé API personnelle (compte Studio ou Développeur)
MAGICLIGHT_API_KEY=

# ── Google OAuth (YouTube + Drive) ──────────────────────────
# Créés dans Google Cloud Console → APIs & Services → Credentials
# Type d'application : « Application de bureau »
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtenu en lançant : npm run auth
GOOGLE_REFRESH_TOKEN=

# ── Options ─────────────────────────────────────────────────
# ID du dossier Google Drive (laisser vide = création auto « YouTube Automation »)
DRIVE_FOLDER_ID=

# public | unlisted | private
YOUTUBE_PRIVACY=public
