# ── MagicLight ──────────────────────────────────────────────
MAGICLIGHT_API_KEY=

# ── Google OAuth (client « Application de bureau ») ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google n'autorise plus YouTube + Drive dans le MÊME consentement.
# Deux autorisations séparées → deux refresh tokens.
# npm run auth
GOOGLE_REFRESH_TOKEN_YOUTUBE=
GOOGLE_REFRESH_TOKEN_DRIVE=

# ── Options ─────────────────────────────────────────────────
DRIVE_FOLDER_ID=
YOUTUBE_PRIVACY=public
